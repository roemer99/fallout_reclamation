#####################################################################
## FALLOUT RECLAMATION - Vault 21: Caravan lanes of the player (GUI types)
## vcv_lane_p1 ... vcv_lane_p3, used in gui/fallout_caravan_window.gui
## Each card slot stacks the 10 card faces; only the faces up to the card value
## are visible, so the top one is the right card (texture paths cannot contain
## data in EU5). Up to 7 cards are shown per caravan, more cards show "+N".
## Card types (vcv_card_1 ... vcv_card_10): gui/fallout_caravan_cards.gui
## Values: common/script_values/fallout_vav_caravan_values.txt
#####################################################################

types FalloutCaravanLanes_p
{
