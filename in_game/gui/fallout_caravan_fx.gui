#####################################################################
## FALLOUT RECLAMATION - Vault 21: Caravan move animation (GUI types)
##
## The game logic runs instantly; the table then plays the move back:
##   player's face card    fade in 0.0-0.3 s, lies on top of the whole stack, fade out 1.0-1.5 s
##   opponent's new card   fades in at 0.9 s (vcv_opponent_card_reveal)
##   opponent's face card  fade in 0.9-1.2 s, lies on top of the whole stack, fade out 1.9-2.4 s
##   vcv_input_blocker     no clicks on the table for 2.5 s
## Fade in + fade out without chained states: the OUTER widget fades out (delayed),
## the INNER widget fades in; both start together when they become visible.
## Animations (_show) only start when a widget becomes visible, so every turn has
## its own container (visible only in that turn; in the lane types and the window):
## at each turn change a new container appears and all animations inside start again.
## Targets (vcv_f1t / vcv_f2t): 1-3 player's caravan I-III, 4-6 opponent's I-III.
## Values: common/script_values/fallout_vav_caravan_values.txt
#####################################################################

types FalloutCaravanFx
{
	# --- fade in (inner) ---
	type vcv_fx_in_player = widget {
		size = { 100% 100% }
		alpha = 0
		state = { name = _show duration = 0.3 alpha = 1 }
		state = { name = _hide duration = 0 alpha = 0 }
	}
	type vcv_fx_in_opponent = widget {
		size = { 100% 100% }
		alpha = 0
		state = { name = _show delay = 0.9 duration = 0.3 alpha = 1 }
		state = { name = _hide duration = 0 alpha = 0 }
	}

	# --- fade out (outer): the face card leaves the game ---
	type vcv_fx_out_player = widget {
		size = { 100% 100% }
		alpha = 1
		state = { name = _show delay = 1.0 duration = 0.5 alpha = 0 }
		state = { name = _hide duration = 0 alpha = 1 }
	}
	type vcv_fx_out_opponent = widget {
		size = { 100% 100% }
		alpha = 1
		state = { name = _show delay = 1.9 duration = 0.5 alpha = 0 }
		state = { name = _hide duration = 0 alpha = 1 }
	}

	# --- input blocker: covers the table for 2.5 s after every move ---
	type vcv_input_blocker = widget {
		size = { 0 0 }
		alwaystransparent = no
		filter_mouse = all
		state = { name = _show duration = 0 size = { 1100 800 } next = vcv_unblock }
		state = { name = vcv_unblock delay = 2.5 duration = 0 size = { 0 0 } }
		state = { name = _hide duration = 0 size = { 0 0 } }
	}

	# --- face cards on target 1 (your caravan I) ---
	type vcv_fx_1 = widget {
		size = { 90 135 }
		widget = { size = { 100% 100% } visible = "[GreaterThanOrEqualTo_CFixedPoint(GuiScope.SetRoot(GetPlayer.MakeScope).ScriptValue('vcv_f1t'), '(CFixedPoint)1')]"
			widget = { size = { 100% 100% } visible = "[LessThan_CFixedPoint(GuiScope.SetRoot(GetPlayer.MakeScope).ScriptValue('vcv_f1t'), '(CFixedPoint)2')]"
				vcv_fx_out_player = {
					vcv_fx_in_player = {
						# larger than a stack card, lies on top of the whole stack
						widget = { size = { 110 165 } position = { -10 -40 }
							vcv_card_11 = { visible = "[GreaterThanOrEqualTo_CFixedPoint(GuiScope.SetRoot(GetPlayer.MakeScope).ScriptValue('vcv_f1'), '(CFixedPoint)11')]" }
							vcv_card_12 = { visible = "[GreaterThanOrEqualTo_CFixedPoint(GuiScope.SetRoot(GetPlayer.MakeScope).ScriptValue('vcv_f1'), '(CFixedPoint)12')]" }
							vcv_card_13 = { visible = "[GreaterThanOrEqualTo_CFixedPoint(GuiScope.SetRoot(GetPlayer.MakeScope).ScriptValue('vcv_f1'), '(CFixedPoint)13')]" }
							vcv_card_14 = { visible = "[GreaterThanOrEqualTo_CFixedPoint(GuiScope.SetRoot(GetPlayer.MakeScope).ScriptValue('vcv_f1'), '(CFixedPoint)14')]" }
						}
					}
				}
			}
		}
		widget = { size = { 100% 100% } visible = "[GreaterThanOrEqualTo_CFixedPoint(GuiScope.SetRoot(GetPlayer.MakeScope).ScriptValue('vcv_f2t'), '(CFixedPoint)1')]"
			widget = { size = { 100% 100% } visible = "[LessThan_CFixedPoint(GuiScope.SetRoot(GetPlayer.MakeScope).ScriptValue('vcv_f2t'), '(CFixedPoint)2')]"
				vcv_fx_out_opponent = {
					vcv_fx_in_opponent = {
						# larger than a stack card, lies on top of the whole stack
						widget = { size = { 110 165 } position = { -10 -40 }
							vcv_card_11 = { visible = "[GreaterThanOrEqualTo_CFixedPoint(GuiScope.SetRoot(GetPlayer.MakeScope).ScriptValue('vcv_f2'), '(CFixedPoint)11')]" }
							vcv_card_12 = { visible = "[GreaterThanOrEqualTo_CFixedPoint(GuiScope.SetRoot(GetPlayer.MakeScope).ScriptValue('vcv_f2'), '(CFixedPoint)12')]" }
							vcv_card_13 = { visible = "[GreaterThanOrEqualTo_CFixedPoint(GuiScope.SetRoot(GetPlayer.MakeScope).ScriptValue('vcv_f2'), '(CFixedPoint)13')]" }
							vcv_card_14 = { visible = "[GreaterThanOrEqualTo_CFixedPoint(GuiScope.SetRoot(GetPlayer.MakeScope).ScriptValue('vcv_f2'), '(CFixedPoint)14')]" }
						}
					}
				}
			}
		}
	}

