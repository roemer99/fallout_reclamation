#####################################################################
## FALLOUT RECLAMATION - Vault 21: Caravan move log (GUI type)
## Opened / closed with the "Log" button of the Caravan window (vav_cv_toggle_log).
## One row per turn: your card -> target, opponent's card -> target.
## Cards are shown by value (legend: A = 1, J = 11, Q = 12, K = 13, Joker = 14).
## Data: scripted_effects/fallout_vav_caravan_log_effects.txt,
##       script_values/fallout_vav_caravan_values.txt (vcv_l...)
## Side: 0 = discarded, 1 = player's caravan, 2 = opponent's caravan.
#####################################################################

types FalloutCaravanLog
{
	# One target text (discarded / your caravan n / opponent's caravan n).
	# SIDE / YOURS / THEIRS are set per row with blockoverride.
	type vcv_log_target = widget {
		size = { 210 24 }
		widget = { size = { 100% 100% } block "side_none" {} text_single = { text = "VAV_CV_LOG_DISCARDED" } }
		widget = { size = { 100% 100% } block "side_min_yours" {} widget = { size = { 100% 100% } block "side_max_yours" {} text_single = { block "text_yours" {} } } }
		widget = { size = { 100% 100% } block "side_theirs" {} text_single = { block "text_theirs" {} } }
	}

	type vcv_log_panel = widget {
		size = { 720 470 }
		alwaystransparent = yes
		visible = "[GreaterThanOrEqualTo_CFixedPoint(GuiScope.SetRoot(GetPlayer.MakeScope).ScriptValue('vcv_showlog'), '(CFixedPoint)1')]"
		icon = { size = { 100% 100% } texture = "gfx/interface/fallout/caravan/table/shade.dds" alpha = 0.85 alwaystransparent = yes }
		widget = { size = { 100% 100% } alwaystransparent = yes background = { using = bg_expeditions_card_frame_texture } }
		vbox = {
			size = { 100% 100% }
			margin = { 24 18 }
			spacing = 6
			text_single = { text = "VAV_CV_LOG_TITLE" using = Font_Size_Big }
			text_single = { text = "VAV_CV_LOG_LEGEND" }
			text_single = { text = "VAV_CV_LOG_EMPTY" visible = "[LessThan_CFixedPoint(GuiScope.SetRoot(GetPlayer.MakeScope).ScriptValue('vcv_lpc1'), '(CFixedPoint)1')]" }

			# --- turn 1 ---
			hbox = {
				spacing = 6
				visible = "[GreaterThanOrEqualTo_CFixedPoint(GuiScope.SetRoot(GetPlayer.MakeScope).ScriptValue('vcv_lpc1'), '(CFixedPoint)1')]"
				text_single = { size = { 36 24 } autoresize = no text = "VAV_CV_LOG_TURN_1" }
				text_single = { size = { 90 24 } autoresize = no text = "VAV_CV_LOG_CARD_P1" }
				vcv_log_target = {
					blockoverride "side_none" { visible = "[LessThan_CFixedPoint(GuiScope.SetRoot(GetPlayer.MakeScope).ScriptValue('vcv_lps1'), '(CFixedPoint)1')]" }
					blockoverride "side_min_yours" { visible = "[GreaterThanOrEqualTo_CFixedPoint(GuiScope.SetRoot(GetPlayer.MakeScope).ScriptValue('vcv_lps1'), '(CFixedPoint)1')]" }
					blockoverride "side_max_yours" { visible = "[LessThan_CFixedPoint(GuiScope.SetRoot(GetPlayer.MakeScope).ScriptValue('vcv_lps1'), '(CFixedPoint)2')]" }
					blockoverride "side_theirs" { visible = "[GreaterThanOrEqualTo_CFixedPoint(GuiScope.SetRoot(GetPlayer.MakeScope).ScriptValue('vcv_lps1'), '(CFixedPoint)2')]" }
					blockoverride "text_yours" { text = "VAV_CV_LOG_YOURS_P1" }
					blockoverride "text_theirs" { text = "VAV_CV_LOG_THEIRS_P1" }
				}
				text_single = { size = { 140 24 } autoresize = no text = "VAV_CV_LOG_CARD_O1" }
				vcv_log_target = {
					blockoverride "side_none" { visible = "[LessThan_CFixedPoint(GuiScope.SetRoot(GetPlayer.MakeScope).ScriptValue('vcv_los1'), '(CFixedPoint)1')]" }
					blockoverride "side_min_yours" { visible = "[GreaterThanOrEqualTo_CFixedPoint(GuiScope.SetRoot(GetPlayer.MakeScope).ScriptValue('vcv_los1'), '(CFixedPoint)1')]" }
					blockoverride "side_max_yours" { visible = "[LessThan_CFixedPoint(GuiScope.SetRoot(GetPlayer.MakeScope).ScriptValue('vcv_los1'), '(CFixedPoint)2')]" }
					blockoverride "side_theirs" { visible = "[GreaterThanOrEqualTo_CFixedPoint(GuiScope.SetRoot(GetPlayer.MakeScope).ScriptValue('vcv_los1'), '(CFixedPoint)2')]" }
					blockoverride "text_yours" { text = "VAV_CV_LOG_YOURS_O1" }
					blockoverride "text_theirs" { text = "VAV_CV_LOG_THEIRS_O1" }
				}
			}

			# --- turn 2 ---
			hbox = {
				spacing = 6
				visible = "[GreaterThanOrEqualTo_CFixedPoint(GuiScope.SetRoot(GetPlayer.MakeScope).ScriptValue('vcv_lpc2'), '(CFixedPoint)1')]"
